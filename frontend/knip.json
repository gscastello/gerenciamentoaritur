{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/domain/index.js",
    "src/ui/motion/index.js",
    "src/ui/skeletons/*.jsx",
    "src/ui/charts/*.jsx",
    "src/observability/index.js",
    "src/services/*.js",
    "src/hooks/*.js",
    "src/auth/*.jsx"
  ],
  "project": ["src/**/*.{js,jsx}"],
  "vite": { "config": ["vite.config.js"] },
  "vitest": {
    "config": ["vite.config.js"],
    "entry": ["src/**/*.{test,spec}.{js,jsx}", "vitest.setup.js"]
  },
  "playwright": { "config": ["playwright.config.js"], "entry": ["e2e/**/*.spec.js"] },
  "stryker": { "config": ["stryker.config.json"] }
}
