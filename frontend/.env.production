# A anon/publishable key do Supabase é feita para ficar no navegador — quem
# protege os dados é o RLS do banco, não o sigilo da chave. Por isso pode
# ficar versionada. A service_role key NUNCA entra aqui.
#
# Sentry/OTel/Datadog: adicionar como env vars no painel da Vercel quando
# forem configurados (issue #3) — o app funciona sem.

VITE_SUPABASE_URL=https://szwnsacgpsvioswrelqo.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_UWKPnSaRmkowooT-WRn7Cw_8AEcnrUs
VITE_OBSERVABILITY_ENV=production
