# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API no painel do Supabase).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-aqui-a-anon-key

# Nunca coloque a service_role key aqui — ela é só para o backend do
# bot do WhatsApp (que ainda não foi implementado, por instrução explícita
# desta etapa).
