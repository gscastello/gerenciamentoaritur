# Copie para .env e preencha. `frontend/.env` está no .gitignore.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API no painel do Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-aqui-a-anon-key
# Nunca coloque a service_role key aqui — ela é só para o backend do
# bot do WhatsApp (que ainda não foi implementado).

# ── Build / release ─────────────────────────────────────────────────────
# Preenchido pelo CI com o SHA do commit. Deixe "dev" localmente.
VITE_RELEASE=dev
VITE_OBSERVABILITY_ENV=development

# ── Sentry (issue #3) ───────────────────────────────────────────────────
# Project Settings → Client Keys (DSN). O app funciona sem — só não
# reporta erros.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0
# Só no CI (secret), para upload de source maps — não é VITE_*:
# SENTRY_AUTH_TOKEN=

# ── OpenTelemetry (issue #3) ────────────────────────────────────────────
# Endpoint OTLP/HTTP do seu backend (Grafana Tempo, Honeycomb, Datadog…).
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
# Cabeçalhos extras no formato "chave=valor,chave2=valor2" (ex.: api key).
VITE_OTEL_EXPORTER_OTLP_HEADERS=

# ── RUM operacional: escolher UM (AGENTS.md §4) ─────────────────────────
# Datadog RUM
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.com
# …ou New Relic Browser (só ativa se o Datadog estiver vazio)
VITE_NEWRELIC_LICENSE_KEY=
VITE_NEWRELIC_APPLICATION_ID=

# ── Codecov ─────────────────────────────────────────────────────────────
# Só no CI (secret): CODECOV_TOKEN=
